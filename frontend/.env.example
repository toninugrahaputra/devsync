# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Backend API base URL. Defaults to the local Go server if unset.
VITE_API_URL=http://localhost:8080/api/v1

# Google OAuth 2.0 Client ID — same value as the backend's GOOGLE_CLIENT_ID.
# Leave empty to hide the Google sign-in button entirely.
VITE_GOOGLE_CLIENT_ID=
