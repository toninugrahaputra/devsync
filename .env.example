# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it (it holds real credentials in production).

# MySQL connection string. Default below matches a local Homebrew MySQL
# install (root user, no password).
DATABASE_URL=root:@tcp(localhost:3306)/devsync?parseTime=true

# Secret used to sign JWT auth tokens. Set a long random value in production.
JWT_SECRET=devsync-secret-key

# Google OAuth 2.0 Client ID (Web application type) for "Sign in with Google".
# Leave empty to hide the Google sign-in button entirely.
# Create one at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Base URL used to build links inside invite emails (e.g. https://yourapp.com).
FRONTEND_URL=http://localhost:5173

# SMTP settings for sending workspace invite emails. Leave MAIL_HOST empty to
# just log emails instead of sending them — the invite link is still shown
# in the UI for manual sharing either way.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=DevSync
